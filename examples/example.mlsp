- 0.5);\n\n\t\n\n\tvec4 gx1 = ixy1 * (1.0 / 7.0);\n\n\tvec4 gy1 = fract(floor(gx1) * (1.0 / 7.0)) - 0.5;\n\n\tgx1 = fract(gx1);\n\n\tvec4 gz1 = vec4(0.5) - abs(gx1) - abs(gy1);\n\n\tvec4 sz1 = step(gz1, vec4(0.0));\n\n\tgx1 -= sz1 * (step(0.0, gx1) - 0.5);\n\n\tgy1 -= sz1 * (step(0.0, gy1) - 0.5);\n\n\t\n\n\tvec3 g000 = vec3(gx0.x,gy0.x,gz0.x);\n\n\tvec3 g100 = vec3(gx0.y,gy0.y,gz0.y);\n\n\tvec3 g010 = vec3(gx0.z,gy0.z,gz0.z);\n\n\tvec3 g110 = vec3(gx0.w,gy0.w,gz0.w);\n\n\tvec3 g001 = vec3(gx1.x,gy1.x,gz1.x);\n\n\tvec3 g101 = vec3(gx1.y,gy1.y,gz1.y);\n\n\tvec3 g011 = vec3(gx1.z,gy1.z,gz1.z);\n\n\tvec3 g111 = vec3(gx1.w,gy1.w,gz1.w);\n\n\t\n\n\tvec4 norm0 = mlsf_taylorInvSqrt_vec4(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));\n\n\tvec4 norm1 = mlsf_taylorInvSqrt_vec4(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));\n\n\t\n\n\tfloat n000 = norm0.x * dot(g000, Pf0);\n\n\tfloat n010 = norm0.y * dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));\n\n\tfloat n100 = norm0.z * dot(g100, vec3(Pf1.x, Pf0.yz));\n\n\tfloat n110 = norm0.w * dot(g110, vec3(Pf1.xy, Pf0.z));\n\n\tfloat n001 = norm1.x * dot(g001, vec3(Pf0.xy, Pf1.z));\n\n\tfloat n011 = norm1.y * dot(g011, vec3(Pf0.x, Pf1.yz));\n\n\tfloat n101 = norm1.z * dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));\n\n\tfloat n111 = norm1.w * dot(g111, Pf1);\n\n\t\n\n\tvec3 fade_xyz = mlsf_fade_vec3(Pf0);\n\n\tvec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);\n\n\tvec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);\n\n\tfloat n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x); \n\n\treturn 2.2 * n_xyz;\n\n}\n\nfloat mlsf_rand_f(float v)\n{\n\treturn fract(sin(dot(v + 23.208, vec4(12.9898, 78.233, 45.164, 94.673).x)) * 43758.5453);\n}\n\nfloat mlsf_perlin3dLoop(float seed, vec3 P, vec3 rep, float octaves, vec3 octaveMask)\n{\n\t\n\n\tvec4 offset = vec4(mlsf_rand_f(seed + 84.192), mlsf_rand_f(seed + 73.931), mlsf_rand_f(seed + 20.481), mlsf_rand_f(seed + 75.694));  \n\n\t\n\n\tint MAX_OCTAVES = 6;\n\n\tfloat gain = 0.5; // Persistence/gain\n\n\tfloat lacunarity = 2.0; // Frequency multiplier\n\n\t\n\n\tfloat result = 0.0;\n\n\tfloat frequency = 1.0;\n\n\tfloat amplitude = 1.0;\n\n\t\n\n\tvec4 step = vec4(1.7, 2.5, 9.2, 6.6);\n\n\t\n\n\tfor(int i = 0; i < MAX_OCTAVES; i++)\n\n\t{\n\n\t    result += mlsf_perlin3d(offset.xyz, mix(P * frequency, P, octaveMask)- step.xyz * float(i), mix(rep * frequency, rep, octaveMask)) * amplitude;\n\n\t\n\n\t    if(float(i) >= octaves)\n\n\t    {\n\n\t        break;\n\n\t    }\n\n\t\n\n\t    amplitude *= gain;\n\n\t    frequency *= lacunarity;\n\n\t}\n\n\t\n\n\treturn result;\n\n}\n\n\nvoid main()\n{\n\tgl_Position = gl_ModelViewProjectionMatrix * gl_Vertex;\n\tgl_TexCoord[0] = gl_TextureMatrix[0] * gl_MultiTexCoord0;\n\tvec2 var0 = gl_TexCoord[0].xy;\n\tvec2 var1 = ((var0 + 0.f) * 0.75f);\n\tfloat var2 = (P_time * 0.5f);\n\tvec3 var3 = vec3(var1, var2);\n\tfloat var4 = mlsf_perlin3dLoop(0.f, var3, vec3(0.f, 0.f, 1.f), 3.f, vec3(0.f, 0.f, 1.f));\n\tgl_FrontColor = vec4(vec3(var4), 1.0);\n}","zoom":0.7368896007537842}],["Random",{"fragmentShader":"#version 120\n\nuniform sampler2D P_TextureParam;\nuniform vec2 P_TextureParam_texSize;\nuniform float time;\nuniform sampler2D texture;\n\n\nfloat mlsf_rand_f(float v)\n{\n\treturn fract(sin(dot(v + 23.208, vec4(12.9898, 78.233, 45.164, 94.673).x)) * 43758.5453);\n}\n\n\nvoid main()\n{\n\tvec2 var0 = gl_TexCoord[0].xy;\n\tvec4 var1 = texture2D(P_TextureParam, var0);\n\tvec3 var2 = (vec3(1.f, 1.f, 1.f) - var1.rgb);\n\tvec4 var3 = vec4(var2, var1.a);\n\tfloat var4 = mlsf_rand_f(var3.x);\n\tgl_FragColor = vec4(vec3(var4), 1.0);\n}","links":[72057609087090725,72057720756240396,72057742231076897,72057755115978790,72057759410946082,144115314794168325,144115331990814749,144115336302559261],"nodes":[{"id":2,"input_fields":[{"arrity":3,"values":[0.0,0.0,0.0,0.0]}],"pos":{"x":88.0,"y":-642.0},"type_id":"out_vertex"},{"id":3,"input_fields":[{"arrity":4,"values":[0.0,0.0,0.0,0.0]