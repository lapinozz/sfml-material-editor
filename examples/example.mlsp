{"materials":[["Blur",{"fragmentShader":"#version 120\n\nuniform sampler2D P_TextureParam;\nuniform vec2 P_TextureParam_texSize;\nuniform float P_time;\nuniform float time;\nuniform sampler2D texture;\n\n\nvoid mlsf_custom_func_10(sampler2D in_0, vec2 in_1, vec2 in_2, float in_3, out vec4 out_0)\n{\n\t// Blur function\n\t\n\tvec2 texelSize = 1.f / in_2;\n\tvec4 color = vec4(0.f);\n\tint range = int(in_3);\n\t\n\tfor(int x = -range; x <= range; x++)\n\t{\n\t\tcolor += texture2D(in_0, in_1 + vec2(float(x), 0) * texelSize);\n\t}\n\t\n\tfor(int y = -range; y <= range; y++)\n\t{\n\t    color += texture2D(in_0, in_1 + vec2(0, float(y)) * texelSize);\n\t}\n\t\n\tout_0 = color / float((range*2+1) * 2);\n}\n\n\nvoid main()\n{\n\tvec2 var0 = P_TextureParam_texSize;\n\tvec2 var1 = gl_TexCoord[0].xy;\n\tfloat var2 = sin((P_time * 2.f));\n\tfloat var3 = ((var2 + 1.f) * 30.f);\n\tvec4 var4;\n\tmlsf_custom_func_10(P_TextureParam, var1, var0, var3, var4);\n\tgl_FragColor = vec4(var4);\n}","links":[72057609087090698,72057639151861772,72057673511600149,72057686396502043,72057690691469327,72057712166305814,144115233189789701,216172827244494860,288230421265645586],"nodes":[{"id":2,"input_fields":[{"arrity":3,"values":[0.0,0.0,0.0,0.0]}],"pos":{"x":88.0,"y":-642.0},"type_id":"out_vertex"},{"id":3,"input_fields":[{"arrity":4,"values":[0.0,0.0,0.0,0.0]}],"pos":{"x":88.0,"y":-546.0},"type_id":"out_fragment"},{"id":5,"input_fields":{},"pos":{"x":-682.0,"y":-498.0},"type_id":"uv"},{"functionDef":{"body":["// Blur function","","vec2 texelSize = 1.f / in_2;","vec4 color = vec4(0.f);","int range = int(in_3);","","for(int x = -range; x <= range; x++)","{","\tcolor += texture2D(in_0, in_1 + vec2(float(x), 0) * texelSize);","}","","for(int y = -range; y <= range; y++)","{","    color += texture2D(in_0, in_1 + vec2(0, float(y)) * texelSize);","}","","out_0 = color / float((range*2+1) * 2);"],"id":"custom_func_10","params":[{"id":"in_0","isOut":false,"type":-1},{"id":"in_1","isOut":false,"type":2},{