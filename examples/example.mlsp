 t * (t * (t * 6.0 - 15.0) + 10.0);\n}\n\nvec3 mlsf_mod289_vec3(vec3 x)\n{\n\treturn x - floor(x * (1.0 / 289.0)) * 289.0;\n}\n\nvec3 mlsf_safeMod_vec3(vec3 v, vec3 d)\n{\n\treturn vec3(d.x <= 0 ? v.x : mod(v.x, d.x), d.y <= 0 ? v.y : mod(v.y, d.y), d.z <= 0 ? v.z : mod(v.z, d.z));\n}\n\nfloat mlsf_perlin3d(vec3 offset, vec3 P, vec3 rep)\n{\n\t\n\n\tvec3 Pi0 = mlsf_safeMod_vec3(floor(P), rep) + offset; // Integer part, modulo period\n\n\tvec3 Pi1 = mlsf_safeMod_vec3(Pi0 + vec3(1.0), rep); // Integer part + 1, mod period\n\n\tPi0 = mlsf_mod289_vec3(Pi0);\n\n\tPi1 = mlsf_mod289_vec3(Pi1);\n\n\tvec3 Pf0 = fract(P); // Fractional part for interpolation\n\n\tvec3 Pf1 = Pf0 - vec3(1.0); // Fractional part - 1.0\n\n\tvec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);\n\n\tvec4 iy = vec4(Pi0.yy, Pi1.yy);\n\n\tvec4 iz0 = Pi0.zzzz;\n\n\tvec4 iz1 = Pi1.zzzz;\n\n\t\n\n\tvec4 ixy = mlsf_permute_vec4(mlsf_permute_vec4(ix) + iy);\n\n\tvec4 ixy0 = mlsf_permute_vec4(ixy + iz0);\n\n\tvec4 ixy1 = mlsf_permute_vec4(ixy + iz1);\n\n\t\n\n\tvec4 gx0 = ixy0 * (1.0 / 7.0);\n\n\tvec4 gy0 = fract(floor(gx0) * (1.0 / 7.0)) - 0.5;\n\n\tgx0 = fract(gx0);\n\n\tvec4 gz0 = vec4(0.5) - abs(gx0) - abs(gy0);\n\n\tvec4 sz0 = step(gz0, vec4(0.0));\n\n\tgx0 -= sz0 * (step(0.0, gx0) - 0.5);\n\n\tgy0 -= sz0 * (step(0.0, gy0) - 0.5);\n\n\t\n\n\tvec4 gx1 = ixy1 * (1.0 / 7.0);\n\n\tvec4 gy1 = fract(floor(gx1) * (1.0 / 7.0)) - 0.5;\n\n\tgx1 = fract(gx1);\n\n\tvec4 gz1 = vec4(0.5) - abs(gx1) - abs(gy1);\n\n\tvec4 sz1 = step(gz1, vec4(0.0));\n\n\tgx1 -= sz1 * (step(0.0, gx1) - 0.5);\n\n\tgy1 -= sz1 * (step(0.0, gy1) - 0.5);\n\n\t\n\n\tvec3 g000 = vec3(gx0.x,gy0.x,gz0.x);\n\n\tvec3 g100 = vec3(gx0.y,gy0.y,gz0.y);\n\n\tvec3 g010 = vec3(gx0.z,gy0.z,gz0.z);\n\n\tvec3 g110 = vec3(gx0.w,gy0.w,gz0.w);\n\n\tvec3 g001 = vec3(gx1.x,gy1.x,gz1.x);\n\n\tvec3 g101 = vec3(gx1.y,gy1.y,gz1.y);\n\n\tvec3 g011 = vec3(gx1.z,gy1.z,gz1.z);\n\n\tvec3 g111 = vec3(gx1.w,gy1.w,gz1.w);\n\n\t\n\n\tvec4 norm0 = mlsf_taylorInvSqrt_vec4(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));\n\n\tvec4 norm1 = mlsf_taylorInvSqrt_vec4(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));\n\n\t\n\n\tfloat n000 = norm0.x * dot(g000, Pf0);\n\n\tfloat n010 = norm0.y * dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));\n\n\tfloat n100 = norm0.z * dot(g100, vec3(Pf1.x, Pf0.yz));\n\n\tfloat n110 = norm0.w * dot(g110, vec3(Pf1.xy, Pf0.z));\n\n\tfloat n001 = norm1.x * dot(g001, vec3(Pf0.xy, Pf1.z));\n\n\tfloat n011 = norm1.y * dot(g011, vec3(Pf0.x, Pf1.yz));\n\n\tfloat n101 = norm1.z * dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));\n\n\tfloat n111 = norm1.w * dot(g111, Pf1);\n\n\t\n\n\tvec3 fade_xyz = mlsf_fade_vec3(Pf0);\n\n\tvec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);\n\n\tvec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);\n\n\tfloat n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x); \n\n\treturn 2.2 * n_xyz;\n\n}\n\nfloat mlsf_rand_f(float v)\n{\n\treturn fract(sin(dot(v + 23.208, vec4(12.9898, 78.233, 45.164, 94.673).x)) * 43758.5453);\n}\n\nfloat mlsf_perlin3dLoop(float seed, vec3 P, vec3 rep, float octaves, vec3 octaveMask)\n{\n\t\n\n\tvec4 offset = vec4(mlsf_rand_f(seed + 84.192), mlsf_rand_f(seed + 73.931), mlsf_rand_f(seed + 20.481), mlsf_rand_f(seed + 75.694));  \n\n\t\n\n\tint MAX_OCTAVES = 6;\n\n\tfloat gain = 0.5; // Persistence/gain\n\n\tfloat lacunarity = 2.0; // Frequency multiplier\n\n\t\n\n\tfloat result = 0.0;\n\n\tfloat frequency = 1.0;\n\n\tfloat amplitude = 1.0;\n\n\t\n\n\tvec4 step = vec4(1.7, 2.5, 9.2, 6.6);\n\n\t\n\n\tfor(int i = 0; i < MAX_OCTAVES; i++)\n\n\t{\n\n\t    result += mlsf_perlin3d(offset.xyz, mix(P * frequency, P, octaveMask)- step.xyz * float(i), mix(rep * frequency, rep, octaveMask)) * amplitude;\n\n\t\n\n\t    if(float(i) >= octaves)\n\n\t    {\n\n\t        break;\n\n\t    }\n\n\t\n\n\t    amplitude *= gain;\n\n\t    frequency *= lacunarity;\n\n\t}\n\n\t\n\n\treturn result;\n\n}\n\n\nvoid main()\n{\n\tvec2 var0 = gl_TexCoord[0].xy;\n\tvec2 var1 = gl_TexCoord[0].xy;\n\tvec2 var2 = ((var1 + 0.f) * 0.75f);\n\tfloat var3 = (P_time * 0.5f);\n\tvec3 var4 = vec3(var2, var3);\n\tfloat var5 = mlsf_perlin3dLoop(2.f, var4, vec3(0.f, 0.f, 1.f), 3.f, vec3(0.f, 0.f, 1.f));\n\tfloat var6 = mlsf_perlin3dLoop(0.f, var4, vec3(0.f, 0.f, 1.f), 3.f, vec3(0.f, 0.f, 1.f));\n\tvec2 var7 = vec2(var5, var6);\n\tvec2 var8 = (var0 + (var7 * 0.4f));\n\tvec4 var9 = texture2D(P_TextureParam, var8);\n\tgl_FragColor = vec4(var9);\n}","links":[72057604792123428,72057609087090737,72057690691469327,72057768000880683,72057780885782533,72057785180749869,72057789475717156,72057802360619048,72057806655586355,72057819540488242,72057823835455548,72057828130422836,72057841015324720,72057853900226619,72057862490161209,144115344858939449,144115362038808618,144115400693514292,144115413578416181,144115422168350775,144115435053252630,144115443643187257,144115447938154532,144115456528089110],"nodes":[{"id":2,"input_fields":[{"arrity":4,"values":[0.0,0.0,0.0,0.0]}],"pos":{"x":-456.0,"y":-242.0},"type_id":"out_vertex"},{"id":3,"input_fields":[{"arrity":4,"values":[0.0,0.0,0.0,0.0]}],"pos":{"x":-232.0,"y":-114.0},"type_id":"out_fragment"},{"id":5,"input_fields":{},"pos":{"x":-746.0,"y":-514.0},"type_id":"uv"},{"id":15,"input_fields":{},"pos":{"x":-1002.0,"y":-466.0},"type_id":"input_time"},{"id":22,"input_fields":[{"arrity":0},{"arrity":1,"values":[0.5,0.0,0.0,0.0]}],"pos":{"x":-920.0,"y":-454.0},"type_id":"mul"},{"id":36,"input_fields":[{"arrity":1,"values":[0.0,0.0,0.0,0.0]},{"arrity":2,"values":[0.0,0.0,0.0,0.0]},{"arrity":3,"values":[0.0,0.0,1.0,1.0]},{"arrity":1,"values":[3.0,0.0,0.0,0.0]},{"arrity":3,"values":[0.0,0.0,1.0,0.0]}],"pos":{"x":-760.0,"y":-142.0},"type_id":"noise"},{"id":40,"input_fields":[{"arrity":0},{"arrity":1,"values":[0.0,0.0,0.0,0.0]}],"pos":{"x":-460.0,"y":-450.0},"type_id":"mul"},{"field":0.75,"id":42,"input_fields":{},"pos":{"x":-555.0,"y":-386.0},"type_id":"scalar"},{"id":43,"input_fields":[{"arrity":0},{"arrity":1,"va